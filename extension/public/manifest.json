{
  "manifest_version": 3,
  "name": "PhishCatch",
  "description": "Identify and prevent enterprise password leaks",
  "version": "0.16",
  "icons": {
    "128": "icon.png"
  },
  "storage": {
    "managed_schema": "schema.json"
  },
  "externally_connectable": {},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline'; object-src 'self'"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html",
    "default_title": "PhishCatch"
  },
  "web_accessible_resources": [
    {
      "resources": [],
      "matches": ["*://*/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "js/content.js"
      ]
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "permissions": [
    "storage",
    "notifications"
  ]
}
