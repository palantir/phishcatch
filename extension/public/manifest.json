{
  "manifest_version": 3,
  "name": "PhishCatch",
  "description": "Identify and prevent enterprise password leaks",
  "version": "0.20.0",
  "icons": {
    "128": "icon.png"
  },
  "storage": {
    "managed_schema": "schema.json"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://localhost:* https://*"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html",
    "default_title": "PhishCatch"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["js/content.js", "js/vendor.js"]
    }
  ],
  "minimum_chrome_version": "124.0",
  "permissions": ["alarms", "storage", "unlimitedStorage", "notifications"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
